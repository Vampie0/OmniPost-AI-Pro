# Vercel deployment ignore (admin app only deployment)
node_modules
.git
.expo
.turbo
.cache
.pnpm-store
.vercel-tmp
apps/mobile/android
apps/mobile/ios
apps/mobile/assets
apps/mobile/src/assets
apps/mobile/.expo
.qoder
.kilo
*.docx
PROJECT_EXPORT_MASTER.txt

# No blanket *.png here on purpose: apps/admin/public holds the real brand assets
# (favicon set, apple-touch-icon, og-image) and Vercel matches patterns at any
# depth, so ignoring PNGs silently ships a dashboard with no icon or social card.
# Unwanted images are excluded by directory above instead.
